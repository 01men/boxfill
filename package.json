{
  "name": "boxfill",
  "version": "1.0.0",
  "description": "物流箱体测算工具 —— 装柜方案、运费与拼单测算；H5 端零依赖，MCP 服务端供 Agent 接入",
  "private": true,
  "type": "module",
  "files": [
    "h5/js/core",
    "h5/js/vision",
    "server/tools.js",
    "server/vision.js",
    "server/png.js",
    "dsh-plugin/index.mjs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "start": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "deploy": "node scripts/deploy.mjs",
    "mcp": "node server/stdio.js",
    "mcp:http": "node server/http.js",
    "mcp:probe": "node scripts/mcp-probe.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}